# Docker Compose development settings. Use unique local values and do not commit your real .env.
POSTGRES_DB=treelab
POSTGRES_USER=treelab
POSTGRES_PASSWORD=replace-with-a-local-password

# Required runtime setting for a host-run app; Docker Compose builds this from the values above.
DATABASE_URL=postgresql+psycopg://treelab:treelab@localhost:5432/treelab
SESSION_SECRET=replace-with-a-long-random-secret
APP_ENV=development
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
PORT=3000
MAX_UPLOAD_BYTES=26214400
MAX_UPLOAD_ROWS=100000
MAX_UPLOAD_COLUMNS=200
EXPLAINABILITY_MAX_ROWS=1000
CORS_ORIGINS=

# For Supabase, use the PostgreSQL connection string with TLS enabled, for example:
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# For Render staging, set APP_ENV=production, COOKIE_SECURE=true, and use a unique
# SESSION_SECRET with at least 32 characters. CORS_ORIGINS is not needed when the
# frontend and API are served together.
