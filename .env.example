# Docker Compose development settings. Use unique local values and do not commit your real .env.
POSTGRES_DB=treelab
POSTGRES_USER=treelab
POSTGRES_PASSWORD=replace-with-a-local-password

# Required runtime setting for a host-run app; Docker Compose builds this from the values above.
DATABASE_URL=postgresql+psycopg://treelab:treelab@localhost:5432/treelab
SESSION_SECRET=replace-with-a-long-random-secret
APP_ENV=development
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
PORT=3000
MAX_UPLOAD_BYTES=26214400
MAX_UPLOAD_ROWS=100000
MAX_UPLOAD_COLUMNS=200
CORS_ORIGINS=

# For Azure Database for PostgreSQL Flexible Server, use a TLS DSN, for example:
# DATABASE_URL=postgresql+psycopg://user:password@server.postgres.database.azure.com:5432/treelab?sslmode=require
# Set APP_ENV=production and COOKIE_SECURE=true for production deployments.
